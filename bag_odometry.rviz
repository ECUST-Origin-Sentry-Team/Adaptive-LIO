Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: LIO PointCloud
      Enabled: true
      Topic:
        Value: /livox/scan
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Position Transformer: XYZ
      Color Transformer: Intensity
      Style: Points
      Size (Pixels): 2
      Decay Time: 10
    - Class: rviz_default_plugins/Path
      Name: LIO Path
      Enabled: true
      Topic:
        Value: /odometry_path
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Odometry
      Name: LIO Odometry
      Enabled: true
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 100
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Alpha: 1
        Shaft Length: 0.1
        Shaft Radius: 0.01
        Head Length: 0.03
        Head Radius: 0.01
      Covariance:
        Value: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 0
        Y: 0
        Z: 0
  Name: root
Window Geometry:
  Width: 1280
  Height: 800
