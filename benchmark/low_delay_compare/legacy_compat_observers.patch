+// Optional observers only: retain legacy queues, prediction, and publication
+// decisions unchanged. Flush explicitly before legacy unjoined-thread shutdown.
+class LegacyObservers {
+public:
+    static LegacyObservers& Get(){static LegacyObservers observer;return observer;}
+    void Trace(char event,double stamp,double extra){
+        std::lock_guard<std::mutex> lock(mutex_);
+        if(output_.is_open())output_<<event<<' '<<stamp<<' '<<extra<<' '<<Now()<<'\n';
+    }
+    void Input(double stamp){
+        std::lock_guard<std::mutex> lock(mutex_);
+        const double now=Now();
+        // 0/0 are placeholders: the old adapter has no new quality gate.
+        if(imu_.is_open())imu_<<stamp<<" 0 0 "<<now<<'\n';
+        if(output_.is_open())output_<<"C "<<stamp<<" 0 "<<now<<'\n';
+    }
+    void Posterior(const SE3& pose,double stamp){
+        std::lock_guard<std::mutex> lock(mutex_);
+        if(!trajectory_.is_open())return;
+        const auto& p=pose.translation();const auto q=pose.unit_quaternion();
+        trajectory_<<stamp<<' '<<p.x()<<' '<<p.y()<<' '<<p.z()<<' '
+            <<q.x()<<' '<<q.y()<<' '<<q.z()<<' '<<q.w()<<'\n';
+    }
+    void Flush(){std::lock_guard<std::mutex> lock(mutex_);output_.flush();imu_.flush();trajectory_.flush();}
+private:
+    static double Now(){return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();}
+    LegacyObservers(){
+        if(const char* p=std::getenv("ADAPTIVE_LIO_OUTPUT_TRACE"))output_.open(p);
+        if(const char* p=std::getenv("ADAPTIVE_LIO_IMU_TRACE"))imu_.open(p);
+        if(!FLAGS_trajectory_file.empty())trajectory_.open(FLAGS_trajectory_file);
+        output_<<std::setprecision(17);imu_<<std::setprecision(17);trajectory_<<std::setprecision(17);
+    }
+    std::mutex mutex_;
+    std::ofstream output_,imu_,trajectory_;
+};
 
